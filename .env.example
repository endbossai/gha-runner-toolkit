# gha-runner-toolkit — runtime configuration template.
# Copy to .env (gitignored), fill in the values, then `docker compose up -d`.
#
# DO NOT commit the real .env. The PAT is a long-lived secret with
# repository scope; leaking it lets anyone register a runner on
# your repo.

# Personal Access Token. The entrypoint uses this to mint short-lived
# registration + removal tokens. Required PAT scope depends on
# RUNNER_SCOPE below — see the table next to that variable. The
# placeholder is deliberately not prefixed with `ghp_` to avoid
# false-positives from secret-scanning tools on committed examples.
GITHUB_PAT=<paste-classic-PAT-or-fine-grained-token-here>

# Where the runner registers. Pick one:
#
#   repo       (default) — single repository
#   org                  — entire org; any repo in the org can use this runner
#   enterprise           — entire enterprise (cross-org, GHES / GHEC)
#
# Required env vars + PAT scopes per choice:
#
#   ┌────────────┬────────────────────────────┬───────────────────────────────────────────────────┐
#   │ scope      │ required vars              │ PAT scope                                         │
#   ├────────────┼────────────────────────────┼───────────────────────────────────────────────────┤
#   │ repo       │ GITHUB_OWNER + GITHUB_REPO │ classic: repo                                     │
#   │            │                            │ fine-grained: Administration: write (on the repo) │
#   │ org        │ GITHUB_OWNER (= org login) │ classic: admin:org                                │
#   │            │                            │ fine-grained: Self-hosted runners: write (org)    │
#   │ enterprise │ GITHUB_ENTERPRISE (slug)   │ enterprise admin with manage_runners:enterprise   │
#   └────────────┴────────────────────────────┴───────────────────────────────────────────────────┘
#
# Leave commented to use the default (repo).
# RUNNER_SCOPE=repo

# Repo / org coordinates. Set per the table above.
#   - RUNNER_SCOPE=repo  → set BOTH GITHUB_OWNER (org or user) AND GITHUB_REPO
#   - RUNNER_SCOPE=org   → set GITHUB_OWNER (the org login); leave GITHUB_REPO unset
#   - RUNNER_SCOPE=enterprise → comment both out; set GITHUB_ENTERPRISE instead
GITHUB_OWNER=your-org-or-user
GITHUB_REPO=your-repo

# Enterprise slug. Only used when RUNNER_SCOPE=enterprise. The slug
# is the path segment in github.com/enterprises/<slug>.
# GITHUB_ENTERPRISE=your-enterprise-slug

# Stable name for the runner shown in the repo's Actions settings.
# Convention: ${purpose-or-host}-${index}. If you add a second
# runner on a different host, increment or rename.
RUNNER_NAME=runner-1

# Labels that workflows select on via `runs-on: [self-hosted, linux, <label>]`.
# `self-hosted` + `Linux` + `X64` are added automatically by the agent;
# add your own label(s) here so workflows can target this specific
# runner pool rather than any self-hosted runner on the org. Comma-
# separated for multiple labels.
RUNNER_LABELS=self-hosted-pool

# ──────────────────────────────────────────────────────────────────
# Required values stop here. Everything below is optional.
# ──────────────────────────────────────────────────────────────────

# Docker socket GID. v1.2+ auto-detects this from the mounted
# /var/run/docker.sock at container start, so you don't need to set
# it. Override only if auto-detect fails (e.g. exotic socket setups
# where stat returns 0 but the host's docker group is something else).
# Discover via: `getent group docker | cut -d: -f3` on the host.
# Typical values: 999 on Debian/Ubuntu VPS; 0 on Docker Desktop.
# DOCKER_GID=999

# Container name. Override when running multiple instances on one
# host — each needs a unique name. Default: gha-runner.
# CONTAINER_NAME=gha-runner

# Maximum seconds to wait for an in-flight job before forcing the
# daily recycle. Bump if your jobs routinely exceed 10 minutes and
# you'd rather wait than kill them. Default: 600.
# RECYCLE_DRAIN_TIMEOUT_SECONDS=600

# How often (seconds) to re-query the GitHub API for the runner's
# busy state during drain. Tighten only if your jobs are very short.
# Default: 30.
# RECYCLE_DRAIN_POLL_SECONDS=30

# Age window for the post-recycle reclaim pass: prunes stopped
# containers, orphan networks, and dangling images older than this,
# and bounds the testcontainer reap below. Set to "until=0" to skip
# reclaim entirely; set a shorter window (e.g. "until=12h") on
# disk-pressure hosts. Default: until=24h.
# RECYCLE_PRUNE_FILTER=until=24h

# Stop+remove RUNNING orphan Testcontainers sidecars (Postgres/Kafka/
# etc.) left behind by crashed test runs. Because Ryuk is disabled,
# these otherwise keep running on the host, accumulating memory and
# connections across recycles. Only containers labelled
# `org.testcontainers` and older than RECYCLE_PRUNE_FILTER are reaped,
# so a concurrent runner's in-flight job is never killed. Set to
# "false" if you run unrelated Testcontainers workloads on this host.
# Default: true.
# RECYCLE_REAP_TESTCONTAINERS=true

# Webhook to notify when the daily recycle's drain phase exceeds
# RECYCLE_DRAIN_TIMEOUT_SECONDS (i.e. a long-running job got
# force-stopped). The POST body is a small JSON document with
# `event`, `runner`, `repo`, `timeout_seconds`, `timestamp` fields —
# wire it into Slack/Discord/Teams via their inbound-webhook URL,
# or any HTTP endpoint that accepts JSON. Leave unset to disable.
# RECYCLE_NOTIFY_WEBHOOK=https://hooks.slack.com/services/...
